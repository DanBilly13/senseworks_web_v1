# Copy to .env.local (gitignored) and fill in after running:
#   npx sanity login
#   npx sanity init --env --create-project "Senseworks Web Block Library" --dataset production
#
# These two are public identifiers (safe to expose to the client),
# not secrets — Sanity's actual access control happens via Studio auth.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
